# LLM provider: "anthropic" yoki "groq"
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fayl tool'lari faqat shu papka ichida ishlashi mumkin (path traversal himoyasi)
WORKSPACE_DIR=./workspace

# Agent siklidagi maksimal qadamlar soni (cheksiz aylanishning oldini olish uchun)
MAX_STEPS=15

# --- ASOSIBOT (shaxsiy yordamchi) ---
# Miya modeli (Ollama). Bo'sh bo'lsa OLLAMA_MODEL ishlatiladi.
ASOSIBOT_MODEL=qwen3:8b
# SQLite bazasi joyi (bo'sh bo'lsa loyiha ildizida asosibot.db)
ASOSIBOT_DB=
# Ovoz (STT/TTS) uchun HuggingFace token — bo'sh bo'lsa ovoz o'chirilgan, matn ishlaydi
HUGGINGFACE_TOKEN=
HF_STT_MODEL=openai/whisper-small
HF_TTS_MODEL=facebook/mms-tts-uzn
